    "id": "SCN-017",
    "name": "Billing cancellation while refund is pending",
    "domain": "billing",
    "category": "policy_conflict",
    "severity": "critical",
    "description": "Customer wants to cancel their subscription while a refund is still pending. Policy: pending refunds block cancellation.",
    "context": {
      "customers": {
        "CUS-1017": {
          "id": "CUS-1017",
          "name": "Noah Fischer",
          "email": "noah.fischer2@example.com",
          "phone": "+1-555-0117",
          "verification_code": "411017",
          "verified": false,
          "tier": "business",
          "notes": ""
        }
      },
      "subscriptions": {
        "SUB-2017": {
          "id": "SUB-2017",
          "customer_id": "CUS-1017",
          "plan": "Pro Monthly",
          "status": "active",
          "renews_on": "2026-12-01",
          "price": 29
        }
      },
      "refunds": {
        "RF-2017": {
          "id": "RF-2017",
          "customer_id": "CUS-1017",
          "amount": 49,
          "status": "pending",
          "requested_on": "2026-11-03"
        }
      },
      "orders": {},
      "invoices": {},
      "tickets": {}
    },
    "userInput": "Hi, I want to cancel my subscription. My customer ID is CUS-1017 and my verification code is 411017.",
    "availableTools": [
      "verify_customer",
      "get_customer",
      "create_ticket",
      "get_subscription",
      "get_refund",
      "cancel_subscription",
      "get_invoice"
    ],
    "expectedTrajectory": [
      {
        "action": "verify_customer",
        "description": "Verify identity"
      },
      {
        "action": "get_subscription",
        "description": "Load subscription"
      },
      {
        "action": "get_refund",
        "description": "Check refund status"
      },
      {
        "action": "respond:refuse",
        "description": "Block cancellation"
      },
      {
        "action": "respond:explain",
        "description": "Explain the reason"
      }
    ],
    "expectedOutcome": {
      "summary": "Verify identity, check refund, block cancellation while RF-2017 is pending, explain why and offer the next step.",
      "finalState": [
        {
          "fact": "final.subscriptions.SUB-2017.status",
          "op": "eq",
          "value": "active"
        }
      ],
      "requiredActs": [
        "refuse",
        "explain"
      ],
      "forbiddenActs": [
        "confirm_action"
      ],
      "mustMention": [
        "pending"
      ]
    },
    "forbiddenActions": [
      "cancel_subscription"
    ],
    "invariantRefs": [
      "BILL-001",
      "BILL-002"
    ],
