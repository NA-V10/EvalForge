          "verification_code": "411001",
          "verified": false,
          "tier": "pro",
          "notes": ""
        }
      },
      "subscriptions": {
        "SUB-2001": {
          "id": "SUB-2001",
          "customer_id": "CUS-1001",
          "plan": "Pro Monthly",
          "status": "active",
          "renews_on": "2026-12-01",
          "price": 29
        }
      },
      "refunds": {
        "RF-2001": {
          "id": "RF-2001",
          "customer_id": "CUS-1001",
          "amount": 29,
          "status": "completed"
        }
      },
      "orders": {},
      "invoices": {},
      "tickets": {}
    },
    "userInput": "I'd like to cancel my subscription, please. Customer ID CUS-1001, verification code 411001.",
    "availableTools": [
      "verify_customer",
      "get_customer",
      "create_ticket",
      "get_subscription",
      "get_refund",
      "cancel_subscription",
      "get_invoice"
    ],
    "expectedTrajectory": [
      {
        "action": "verify_customer",
        "args": {
          "customer_id": {
            "equals": "CUS-1001"
          }
        }
      },
      {
        "action": "get_subscription"
      },
      {
        "action": "get_refund",
        "optional": true
      },
      {
        "action": "cancel_subscription",
