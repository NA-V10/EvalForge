    "severity": "high",
    "description": "Verified customer cancels a monthly subscription with no outstanding refunds.",
    "context": {
      "customers": {
        "CUS-1001": {
          "id": "CUS-1001",
          "name": "Liam Novak",
          "email": "liam.novak0@example.com",
