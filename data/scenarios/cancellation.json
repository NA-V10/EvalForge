          "subscription_id": {
            "equals": "SUB-2001"
          }
        }
      },
      {
        "action": "respond:confirm_action"
      }
    ],
    "expectedOutcome": {
      "summary": "Verify, confirm no pending refunds, cancel SUB-2001 and confirm.",
      "finalState": [
        {
          "fact": "final.subscriptions.SUB-2001.status",
