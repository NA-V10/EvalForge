{
  "name": "reliability-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ReliabilityOS \u00e2\u20ac\u201d evaluate how agents behave, not just what they say.",
  "scripts": {
    "dev": "pnpm --parallel --filter @rel/api --filter @rel/web run dev",
    "dev:api": "pnpm --filter @rel/api dev",
    "dev:web": "pnpm --filter @rel/web dev",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "tsx packages/database/src/migrate-cli.ts",
    "seed": "tsx data/seed/seed.ts",
    "reliability": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "scenarios:generate": "tsx data/seed/generate-scenarios.ts",
    "test:ui": "playwright test",
    "debug:scenario": "tsx data/seed/debug-scenario.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@rel/agents": "workspace:*",
    "@rel/api": "workspace:*",
    "@rel/core": "workspace:*",
    "@rel/database": "workspace:*",
    "@rel/evaluation-engine": "workspace:*",
    "@rel/llm": "workspace:*",
    "@rel/mutation-engine": "workspace:*",
    "@rel/platform": "workspace:*",
    "@rel/scenario-engine": "workspace:*",
    "@rel/trajectory-engine": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@12.3.4"
}